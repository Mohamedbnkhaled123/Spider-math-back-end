# ==============================================================================
# Spider Math Educational Platform — Environment Variables
# Version: v2.0 | Architecture: MEAN Stack Serverless
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# MongoDB Atlas Database Connection (M0 Free Tier - 512MB / M1 Recommended)
MONGODB_URI=mongodb+srv://spider_math_dev:example_password@cluster0.abcde.mongodb.net/spider_math_db?retryWrites=true&w=majority

# Security: 512-bit JWT Signing Secret (Minimum 64 ASCII characters / 128 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=c8f59d4e7a1b3c6f8e2d4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e
JWT_EXPIRES_IN=7d

# Cryptography: AES-256-GCM 32-Byte Secret Key (Strictly 64 hex characters)
# Used to encrypt unlisted YouTube Video IDs for protected course lectures
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIDEO_CIPHER_SECRET=4f9b2d8e1a7c3f5b8e0d2a4b6c8e0f2a4b6c8e0f2a4b6c8e0f2a4b6c8e0f2a4b

# Google OAuth 2.0 Client ID (Lead Gate & Student One-Click Auth)
GOOGLE_CLIENT_ID=example-spider-math-client-id.apps.googleusercontent.com

# Cloudinary CDN (100% Reserved Exclusively for Student WebP Homework Photos <= 150KB)
CLOUDINARY_CLOUD_NAME=spider-math-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
