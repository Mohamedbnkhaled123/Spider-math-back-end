# ==============================================================================
# Spider Math Educational Platform — Backend Environment Configuration
# Architecture Baseline: MEAN Stack Serverless (Node.js LTS + Express.js + TypeScript)
# Constitution: RULES.md v2.0 | Client: Eng. Heba Abdel-Wahab
# ==============================================================================

# Server & Network Gateway
PORT=5000
NODE_ENV=production
# Comma-separated allowed frontend origins for CORS (e.g. Local + Production Vercel domain)
CLIENT_ORIGIN=http://localhost:4200,http://localhost:4000,https://spidermath.edu,https://spider-math-frontend.vercel.app

# ==============================================================================
# MongoDB Atlas Database Connection (M0 Free Tier - 512MB / M1 Recommended)
# Note: Ensure IP Whitelist in Atlas includes 0.0.0.0/0 for Vercel Serverless
# ==============================================================================
MONGODB_URI=mongodb+srv://spider_math_admin:StrongPasswordHere@cluster0.abcde.mongodb.net/spider_math_db?retryWrites=true&w=majority

# ==============================================================================
# Cryptographic Security Secrets
# ==============================================================================
# 512-bit JWT Signing Secret (Minimum 64 ASCII characters / 128 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=c8f59d4e7a1b3c6f8e2d4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e2f4a6b8c0e
JWT_EXPIRES_IN=7d

# Cryptography: AES-256-GCM 32-Byte Secret Key (Strictly 64 hex characters)
# Used to encrypt unlisted YouTube Video IDs for protected course lectures
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIDEO_CIPHER_SECRET=4f9b2d8e1a7c3f5b8e0d2a4b6c8e0f2a4b6c8e0f2a4b6c8e0f2a4b6c8e0f2a4b

# Google OAuth 2.0 Client ID (Lead Gate & Student One-Click Auth)
GOOGLE_CLIENT_ID=157492277386-example.apps.googleusercontent.com

# ==============================================================================
# Dual-Folder Cloudinary CDN Configuration
# Mandatory RULES.md Section 4.4 & 5.1 Rules:
# 1. 'spider-math-questions/' : Teacher question diagrams uploaded directly from device
# 2. 'spider-math-homework/'  : Student WebP homework photos (<= 150KB per photo)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=spider-math-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
