{
  "version": 2,
  "name": "spider-math-backend",
  "regions": ["fra1"],
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 15,
        "memory": 1024
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "src/server.ts",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
      }
    },
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
